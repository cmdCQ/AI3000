<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>AI 对话 · 三千问</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #faf8f5;
  --bg-card: #ffffff;
  --bg-hover: #f5f2ec;
  --border: #e8e3d8;
  --border-active: #d4c9b0;
  --accent: #b8960a;
  --accent-dim: #9a8b7a;
  --accent-bg: rgba(184,150,10,0.06);
  --text: #1a1a1a;
  --text-dim: #777777;
  --text-muted: #aaaaaa;
  --radius: 12px;
  --radius-sm: 10px;
  --radius-md: 14px;
  --shadow-card: 0 1px 4px rgba(0,0,0,0.06);
  --sans: "Noto Sans SC", -apple-system, sans-serif;
  --serif: "Noto Serif SC", serif;
}
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html,body { background:var(--bg); color:var(--text); font-family:var(--sans); height:100%; overflow:hidden; -webkit-font-smoothing:antialiased; }
.chat-app { display:flex; flex-direction:column; height:100%; max-width:500px; margin:0 auto; position:relative; }

/* ===== Top Bar ===== */
.chat-topbar { display:flex; align-items:center; padding:0.6rem 0.8rem; border-bottom:1px solid var(--border); background:var(--bg-card); flex-shrink:0; }
.chat-topbar .back-btn { background:none; border:none; font-size:1.1rem; color:var(--text-dim); cursor:pointer; padding:0.2rem 0.4rem; border-radius:8px; transition:all 0.2s; font-family:var(--sans); }
.chat-topbar .back-btn:hover { background:var(--bg-hover); color:var(--text); }
.chat-topbar .title { flex:1; text-align:center; font-family:var(--serif); font-size:0.95rem; font-weight:600; letter-spacing:0.06em; color:var(--text); }
.chat-topbar .clear-btn { background:none; border:none; font-size:0.72rem; color:var(--text-muted); cursor:pointer; padding:0.2rem 0.5rem; border-radius:6px; transition:all 0.2s; font-family:var(--sans); }
.chat-topbar .clear-btn:hover { color:var(--text-dim); }

/* ===== Messages Area ===== */
.msgs-area { flex:1; overflow-y:auto; padding:1rem 0.8rem 0.5rem; -webkit-overflow-scrolling:touch; scroll-behavior:smooth; }

.msgs-empty { text-align:center; padding:3rem 1rem; color:var(--text-muted); }
.msgs-empty .empty-icon { font-size:2.5rem; margin-bottom:0.4rem; opacity:0.3; }
.msgs-empty .empty-title { font-family:var(--serif); font-size:0.95rem; color:var(--text-dim); margin-bottom:0.3rem; }
.msgs-empty .empty-desc { font-size:0.76rem; line-height:1.7; }

/* Message Bubbles */
.msg { max-width:92%; margin-bottom:0.7rem; animation:fadeIn 0.2s ease; }
@keyframes fadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

.msg-user { margin-left:auto; }
.msg-ai { margin-right:auto; }

.msg-bubble { padding:0.65rem 0.85rem; border-radius:var(--radius-md); font-size:0.84rem; line-height:1.7; word-break:break-word; }

.msg-user .msg-bubble { background:var(--accent); color:#fff; border-bottom-right-radius:4px; }
.msg-user .msg-bubble p { margin-bottom:0.3rem; }
.msg-user .msg-bubble p:last-child { margin-bottom:0; }
.msg-user .msg-bubble a { color:#fff; text-decoration:underline; }

.msg-ai .msg-bubble { background:var(--bg-card); border:1px solid var(--border); border-bottom-left-radius:4px; box-shadow:var(--shadow-card); }

.msg-ai .msg-bubble .ai-spinner { display:inline-block; width:16px; height:16px; border:2px solid var(--border); border-top-color:var(--accent); border-radius:50%; animation:sp 0.7s linear infinite; vertical-align:middle; margin-right:0.4rem; }
@keyframes sp { to{transform:rotate(360deg)} }

.msg-ai .msg-bubble p { margin-bottom:0.4rem; }
.msg-ai .msg-bubble p:last-child { margin-bottom:0; }
.msg-ai .msg-bubble strong { color:var(--accent); font-weight:600; }
.msg-ai .msg-bubble h3 { font-family:var(--serif); font-size:0.82rem; font-weight:600; margin:0.6rem 0 0.3rem; color:var(--text); }
.msg-ai .msg-bubble h2 { font-family:var(--serif); font-size:0.9rem; font-weight:600; margin:0.7rem 0 0.3rem; color:var(--text); }
.msg-ai .msg-bubble hr { border:none; border-top:1px solid var(--border); margin:0.5rem 0; }
.msg-ai .msg-bubble blockquote { padding:0.3rem 0.6rem; margin:0.3rem 0; border-left:3px solid var(--accent); background:var(--bg); border-radius:0 6px 6px 0; font-size:0.78rem; color:var(--text-dim); }
.msg-ai .msg-bubble ul, .msg-ai .msg-bubble ol { padding-left:1.2rem; margin-bottom:0.3rem; }
.msg-ai .msg-bubble li { margin-bottom:0.15rem; }
.msg-ai .msg-bubble code { background:#f5f4f0; padding:0.1rem 0.3rem; border-radius:3px; font-size:0.78rem; }
.msg-ai .msg-bubble pre { background:#f5f4f0; padding:0.6rem; border-radius:6px; font-size:0.75rem; overflow-x:auto; margin:0.4rem 0; line-height:1.5; }

.msg-token { font-size:0.62rem; color:var(--text-muted); padding:0.2rem 0.85rem 0; text-align:right; }

/* Error message */
.msg-ai .msg-error { color:#c94a4a; }

/* ===== Card Share Messages ===== */
.msg-card { max-width:98%; margin-bottom:0.7rem; animation:fadeIn 0.2s ease; }
.msg-card .card-box { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-card); }

.card-box .card-hdr { display:flex; align-items:center; gap:0.4rem; padding:0.5rem 0.7rem; background:var(--bg); border-bottom:1px solid var(--border); font-size:0.72rem; color:var(--text-dim); }
.card-box .card-hdr .card-type-icon { font-size:0.9rem; }
.card-box .card-hdr .card-type-label { font-weight:500; }

.card-box .card-body { padding:0.65rem 0.7rem; font-size:0.78rem; line-height:1.6; }
.card-box .card-body .card-topic { font-weight:600; font-size:0.82rem; margin-bottom:0.3rem; color:var(--text); }
.card-box .card-body .card-meta { display:flex; flex-wrap:wrap; gap:0.3rem 0.6rem; margin-bottom:0.4rem; font-size:0.7rem; color:var(--text-dim); }
.card-box .card-body .card-meta span { white-space:nowrap; }

/* 排盘卡片 - 迷你五卦显示 */
.card-hex-mini { display:flex; gap:0; margin:0.3rem 0; border:1px solid var(--border); border-radius:8px; overflow:hidden; }
.card-hex-mini .hex-item { flex:1; text-align:center; padding:0.3rem 0.15rem; font-size:0.7rem; }
.card-hex-mini .hex-item + .hex-item { border-left:1px solid var(--border); }
.card-hex-mini .hex-item .hex-label { font-size:0.58rem; color:var(--text-muted); margin-bottom:0.15rem; }
.card-hex-mini .hex-item .hex-name { font-family:var(--serif); font-weight:600; font-size:0.72rem; color:var(--text); }
.card-hex-mini .hex-item .hex-lines { display:flex; flex-direction:column; align-items:center; gap:3px; margin:0.15rem 0; }
.card-hex-mini .hex-item .hex-line { height:2.5px; border-radius:1px; }
.card-hex-mini .hex-item .hl-yang { width:22px; background:var(--text); }
.card-hex-mini .hex-item .hl-yin { display:flex; gap:5px; justify-content:center; }
.card-hex-mini .hex-item .hl-yin span { width:8px; height:2.5px; background:var(--text); border-radius:1px; display:block; }

/* 六爻双列卡片 */
.card-ly-hex { display:flex; gap:0; margin:0.3rem 0; border:1px solid var(--border); border-radius:8px; overflow:hidden; }
.card-ly-hex .ly-col { flex:1; text-align:center; padding:0.3rem 0.2rem; font-size:0.65rem; }
.card-ly-hex .ly-col + .ly-col { border-left:1px solid var(--border); }
.card-ly-hex .ly-col .ly-title { font-size:0.6rem; color:var(--text-muted); margin-bottom:0.2rem; font-weight:500; }
.card-ly-rows { display:flex; flex-direction:column; align-items:center; gap:2px; }
.card-ly-row { display:flex; align-items:center; gap:2px; font-size:0.6rem; }
.card-ly-row .ly-lq { width:1.2rem; text-align:right; color:var(--text-dim); }
.card-ly-row .ly-dz { width:1.1rem; text-align:center; color:var(--text-dim); }
.card-ly-row .ly-bar { width:1.4rem; text-align:center; }
.card-ly-row .ly-bar .b-yang { display:inline-block; width:14px; height:2px; background:var(--text); border-radius:1px; }
.card-ly-row .ly-bar .b-yin { display:inline-flex; gap:3px; justify-content:center; }
.card-ly-row .ly-bar .b-yin i { display:block; width:5px; height:2px; background:var(--text); border-radius:1px; }
.card-ly-row .ly-mv { width:0.7rem; text-align:center; font-size:0.55rem; }

/* 命盘卡片 */
.card-chart-info { display:flex; flex-direction:column; gap:0.2rem; }
.card-chart-info .cci-row { display:flex; align-items:center; gap:0.4rem; font-size:0.76rem; }
.card-chart-info .cci-label { color:var(--text-dim); min-width:3em; font-size:0.68rem; }
.card-chart-bazi { display:flex; gap:0.3rem; margin:0.3rem 0; justify-content:center; }
.card-chart-bazi .bazi-pillar { display:flex; flex-direction:column; align-items:center; }
.card-chart-bazi .bazi-ganzhi { font-family:var(--serif); font-size:1rem; color:var(--text); font-weight:600; }
.card-chart-bazi .bazi-label { font-size:0.55rem; color:var(--text-muted); margin-top:0.05rem; }
.card-chart-footer { font-size:0.65rem; color:var(--text-muted); padding:0.3rem 0.7rem 0.4rem; border-top:1px solid var(--border); }
.card-chart-footer .ccf-tag { display:inline-block; padding:0.05rem 0.4rem; border-radius:4px; background:var(--accent-bg); color:var(--accent-dim); font-size:0.6rem; margin-right:0.3rem; }

/* ===== Input Area ===== */
.input-area { border-top:1px solid var(--border); background:var(--bg-card); padding:0.5rem 0.6rem; padding-bottom:calc(0.5rem + env(safe-area-inset-bottom,0px)); flex-shrink:0; }

.input-share-bar { display:flex; align-items:center; gap:0.3rem; margin-bottom:0.4rem; }
.input-share-btn { display:inline-flex; align-items:center; gap:0.2rem; padding:0.25rem 0.55rem; font-size:0.7rem; font-family:var(--sans); color:var(--accent-dim); background:var(--accent-bg); border:1px solid rgba(184,150,10,0.15); border-radius:8px; cursor:pointer; transition:all 0.15s; white-space:nowrap; }
.input-share-btn:hover { background:rgba(184,150,10,0.12); border-color:var(--border-active); color:var(--accent); }
.input-share-btn .share-icon { font-size:0.75rem; }

.input-row { display:flex; gap:0.4rem; align-items:flex-end; }
.input-row textarea { flex:1; padding:0.5rem 0.65rem; font-size:0.84rem; font-family:var(--sans); border:1px solid var(--border); border-radius:12px; background:var(--bg); color:var(--text); outline:none; resize:none; line-height:1.5; max-height:120px; transition:border-color 0.2s; }
.input-row textarea:focus { border-color:var(--border-active); }
.input-row textarea::placeholder { color:var(--text-muted); }
.input-send-btn { width:2.2rem; height:2.2rem; display:flex; align-items:center; justify-content:center; background:var(--accent); color:#fff; border:none; border-radius:50%; cursor:pointer; font-size:1rem; transition:opacity 0.15s; flex-shrink:0; }
.input-send-btn:disabled { opacity:0.4; cursor:default; }
.input-send-btn:not(:disabled):hover { opacity:0.85; }

/* ===== Share Picker Overlay ===== */
.picker-overlay { position:fixed; inset:0; z-index:200; background:rgba(0,0,0,0.25); display:none; animation:fadeIn 0.15s ease; }
.picker-overlay.open { display:block; }
.picker-panel { position:fixed; left:0; right:0; bottom:0; z-index:201; max-width:500px; margin:0 auto; background:var(--bg-card); border-radius:16px 16px 0 0; border:1px solid var(--border); border-bottom:none; box-shadow:0 -4px 24px rgba(0,0,0,0.1); display:none; flex-direction:column; max-height:70vh; animation:slideUp 0.25s ease; }
@keyframes slideUp { from{transform:translateY(100%)} to{transform:translateY(0)} }
.picker-panel.open { display:flex; }
.picker-hdr { display:flex; align-items:center; justify-content:space-between; padding:0.8rem 1rem 0.4rem; font-family:var(--serif); font-size:0.9rem; font-weight:600; flex-shrink:0; }
.picker-hdr .picker-close { cursor:pointer; font-size:1.1rem; color:var(--text-muted); opacity:0.5; transition:opacity 0.2s; line-height:1; background:none; border:none; font-family:var(--sans); padding:0.2rem; }
.picker-hdr .picker-close:hover { opacity:1; }

.picker-tabs { display:flex; padding:0 1rem; gap:0.3rem; flex-shrink:0; }
.picker-tab { padding:0.35rem 0.75rem; font-size:0.78rem; font-family:var(--sans); border:1px solid var(--border); border-radius:8px; background:transparent; color:var(--text-dim); cursor:pointer; transition:all 0.15s; }
.picker-tab.active { background:var(--accent); color:#fff; border-color:var(--accent); }

.picker-body { flex:1; overflow-y:auto; padding:0.5rem 1rem 1rem; -webkit-overflow-scrolling:touch; }
.picker-item { display:flex; align-items:center; gap:0.6rem; padding:0.65rem 0.7rem; border:1px solid var(--border); border-radius:10px; margin-bottom:0.4rem; cursor:pointer; transition:all 0.15s; }
.picker-item:hover { border-color:var(--border-active); background:var(--bg-hover); }
.picker-item .pi-icon { font-size:1.1rem; flex-shrink:0; opacity:0.5; }
.picker-item .pi-body { flex:1; min-width:0; }
.picker-item .pi-topic { font-size:0.82rem; font-weight:500; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.picker-item .pi-meta { font-size:0.66rem; color:var(--text-dim); margin-top:0.05rem; }
.picker-empty { text-align:center; padding:2rem 0; color:var(--text-muted); font-size:0.78rem; }
.picker-loading { text-align:center; padding:2rem 0; color:var(--text-dim); font-size:0.78rem; }
.picker-loading .pk-spinner { width:20px; height:20px; border:2px solid var(--border); border-top-color:var(--accent); border-radius:50%; animation:sp 0.7s linear infinite; margin:0 auto 0.4rem; }



@media (max-width:420px) {
  .msgs-area { padding:0.8rem 0.5rem 0.3rem; }
  .msg { max-width:95%; }
  .msg-bubble { padding:0.55rem 0.7rem; font-size:0.8rem; }
  .input-area { padding:0.4rem 0.5rem; }
}
</style>
</head>
<body>
<div class="chat-app">

  <!-- Top Bar -->
  <div class="chat-topbar">
    <button class="back-btn" id="backBtn" onclick="handleBack()">←</button>
    <span class="title">AI 对话</span>
    <button class="clear-btn" id="clearBtn" onclick="clearHistory()">清空</button>
  </div>

  <!-- Messages -->
  <div class="msgs-area" id="msgsArea">
    <div class="msgs-empty" id="emptyState">
      <div class="empty-icon">💬</div>
      <div class="empty-title">开始对话</div>
      <div class="empty-desc">可以直接提问命理问题<br>或点击下方「分享排盘」发送排盘记录</div>
    </div>
  </div>

  <!-- Input Area -->
  <div class="input-area">
    <div class="input-share-bar">
      <button class="input-share-btn" onclick="openSharePicker()"><span class="share-icon">📤</span> 分享排盘/命盘</button>
    </div>
    <div class="input-row">
      <textarea id="chatInput" rows="1" placeholder="输入消息…" onkeydown="onInputKeydown(event)" oninput="autoResizeInput(this)"></textarea>
      <button class="input-send-btn" id="sendBtn" onclick="sendMessage()">➤</button>
    </div>
  </div>

</div>

<!-- Share Picker Overlay -->
<div class="picker-overlay" id="pickerOverlay" onclick="closeSharePicker()"></div>
<div class="picker-panel" id="pickerPanel">
  <div class="picker-hdr">
    <span>📤 分享到对话</span>
    <button class="picker-close" onclick="closeSharePicker()">✕</button>
  </div>
  <div class="picker-tabs">
    <button class="picker-tab active" data-type="mhys" onclick="switchPickerTab('mhys')">🌸 梅花易数</button>
    <button class="picker-tab" data-type="liuyao" onclick="switchPickerTab('liuyao')">🪙 六爻</button>
    <button class="picker-tab" data-type="chart" onclick="switchPickerTab('chart')">🔮 命盘</button>
  </div>
  <div class="picker-body" id="pickerBody">
    <div class="picker-loading"><div class="pk-spinner"></div><div>加载中…</div></div>
  </div>
</div>



<script src="/js/auth.js?v=6"></script>
<script src="/js/hexagrams_data.js?v=1"></script>
<script>
// ===== 八卦/六爻帮助函数 =====
const TRIGRAMS = {
  1:{name:'乾',symbol:'☰'},2:{name:'兑',symbol:'☱'},3:{name:'离',symbol:'☲'},
  4:{name:'震',symbol:'☳'},5:{name:'巽',symbol:'☴'},6:{name:'坎',symbol:'☵'},
  7:{name:'艮',symbol:'☶'},8:{name:'坤',symbol:'☷'}
};

// ===== 状态 =====
var isSending = false;
var streamAbort = null;
var allMessages = [];

// ===== 初始化 =====
document.addEventListener('DOMContentLoaded', function() {
  // 检查登录状态
  if (!AUTH.isLoggedIn()) {
    window.location.href = '/login/';
    return;
  }
  loadHistory();
});

// ===== 返回/关闭 =====
function handleBack() {
  // 如果在 iframe 中，通知父窗口关闭
  if (window.parent && window.parent !== window) {
    window.parent.dispatchEvent(new CustomEvent('closeChatOverlay'));
  } else {
    window.location.href = '/';
  }
}

// ===== 加载历史 =====
async function loadHistory() {
  try {
    var resp = await fetch('/api/chat/history', {
      headers: { 'Authorization': 'Bearer ' + AUTH.getToken() }
    });
    var data = await resp.json();
    if (data.messages && data.messages.length > 0) {
      allMessages = data.messages;
      renderMessages();
    }
  } catch(e) { console.error('Load history error:', e); }
}

// ===== 渲染消息 =====
function renderMessages() {
  var area = document.getElementById('msgsArea');
  var empty = document.getElementById('emptyState');
  if (allMessages.length === 0) {
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';
  area.innerHTML = '';
  for (var i = 0; i < allMessages.length; i++) {
    appendMessageDOM(allMessages[i], false);
  }
  scrollToBottom();
}

function appendMessageDOM(msg, animate) {
  var area = document.getElementById('msgsArea');
  if (msg.role === 'user' && msg.type && msg.type !== 'text' && msg.cardData) {
    // Card message
    var div = document.createElement('div');
    div.className = 'msg-card' + (animate ? '' : '');
    div.innerHTML = renderCard(msg.type, msg.cardData, msg.content || '');
    area.appendChild(div);
    scrollToBottom();
    return;
  }
  if (msg.role === 'user') {
    var div = document.createElement('div');
    div.className = 'msg msg-user' + (animate ? '' : '');
    div.innerHTML = '<div class="msg-bubble">' + escHtml(msg.content || '') + '</div>';
    area.appendChild(div);
    scrollToBottom();
    return;
  }
  if (msg.role === 'assistant') {
    var div = document.createElement('div');
    div.className = 'msg msg-ai' + (animate ? '' : '');
    div.innerHTML = '<div class="msg-bubble">' + renderMarkdown(msg.content || '') + '</div>';
    area.appendChild(div);
    if (msg.tokenInfo) {
      var tokDiv = document.createElement('div');
      tokDiv.className = 'msg-token';
      tokDiv.textContent = msg.tokenInfo;
      area.appendChild(tokDiv);
    }
    scrollToBottom();
  }
}

// ===== 渲染卡片 =====
function renderCard(type, cardData, userText) {
  var icon = '📖', label = '排盘';
  if (type === 'mhys') { icon = '🌸'; label = '梅花易数'; }
  else if (type === 'liuyao') { icon = '🪙'; label = '六爻'; }
  else if (type === 'chart') { icon = '🔮'; label = '命盘'; }

  var h = '<div class="card-box">';
  h += '<div class="card-hdr"><span class="card-type-icon">' + icon + '</span><span class="card-type-label">' + label + '</span></div>';
  h += '<div class="card-body">';

  if (type === 'mhys' || type === 'liuyao') {
    var topic = cardData.topic || '';
    var time = cardData.divinationTime || '';
    var method = cardData.method || '';
    if (topic) h += '<div class="card-topic">' + escHtml(topic) + '</div>';
    h += '<div class="card-meta">';
    if (time) h += '<span>🕐 ' + escHtml(time) + '</span>';
    if (method) h += '<span>📐 ' + escHtml(method) + '</span>';
    if (cardData.gender && type === 'liuyao') h += '<span>' + (cardData.gender === 'female' ? '♀' : '♂') + ' ' + (cardData.gender === 'female' ? '女' : '男') + '</span>';
    h += '</div>';

    if (type === 'mhys' && cardData.hexagrams) {
      var g = cardData.hexagrams;
      h += renderMhysHex(g);
      if (g.ti && g.yong && g.verdict) {
        h += '<div style="margin-top:0.3rem;font-size:0.7rem;padding:0.3rem 0.5rem;background:var(--bg);border-radius:6px;display:flex;gap:0.5rem;align-items:center">';
        h += '<span style="color:var(--accent);font-weight:500">体：' + (g.ti.tri ? g.ti.tri.symbol + g.ti.tri.name : '') + '</span>';
        h += '<span style="color:#5a7fa0;font-weight:500">用：' + (g.yong.tri ? g.yong.tri.symbol + g.yong.tri.name : '') + '</span>';
        h += '<span>' + (g.verdict ? g.verdict.text : '') + '</span>';
        h += '</div>';
      }
    }

    if (type === 'liuyao' && cardData.hexagrams) {
      var g = cardData.hexagrams;
      h += renderLiuyaoHex(g);
    }
  }

  if (type === 'chart') {
    var cd = cardData;
    h += '<div class="card-chart-info">';
    h += '<div class="cci-row"><span class="cci-label">姓名</span><span>' + escHtml(cd.name || '未命名') + '</span></div>';
    h += '<div class="cci-row"><span class="cci-label">性别</span><span>' + (cd.gender === 'female' ? '♀ 女' : '♂ 男') + '</span></div>';
    if (cd.birthYear) {
      h += '<div class="cci-row"><span class="cci-label">出生</span><span>' + cd.birthYear + '年' + cd.birthMonth + '月' + cd.birthDay + '日 ' + cd.birthHour + '时' + '</span></div>';
    }
    if (cd.bazi) {
      var bz = cd.bazi.split('');
      var bzLabels = ['年','月','日','时'];
      h += '<div class="card-chart-bazi">';
      for (var bi = 0; bi < bz.length && bi < 8; bi+=2) {
        h += '<div class="bazi-pillar">';
        h += '<div class="bazi-ganzhi">' + bz[bi] + bz[bi+1] + '</div>';
        h += '<div class="bazi-label">' + bzLabels[bi/2] + '柱</div>';
        h += '</div>';
      }
      h += '</div>';
    }
    h += '</div>';
    h += '<div class="card-chart-footer"><span class="ccf-tag">命盘</span><span>' + (cd.zodiac || cd.shengxiao || '') + '</span></div>';
  }

  if (userText) {
    h += '<div style="margin-top:0.4rem;padding-top:0.3rem;border-top:1px solid var(--border);font-size:0.76rem;color:var(--text-dim)"><span style="font-weight:500;color:var(--accent)">附言：</span>' + escHtml(userText) + '</div>';
  }

  h += '</div></div>';
  return h;
}

function renderMhysHex(g) {
  function triLines(n) { var m={'1':[1,1,1],'2':[1,1,0],'3':[1,0,1],'4':[1,0,0],'5':[0,1,1],'6':[0,1,0],'7':[0,0,1],'8':[0,0,0]}; return m[String(n)]||[0,0,0]; }
  function renderLines(lvs) { var h='<div class="hex-lines">'; for(var i=0;i<lvs.length;i++){h+='<div class="hex-line'+(lvs[i]?' hl-yang"':'"')+'><span></span><span></span></div>';} h+='</div>'; return h; }

  var guas = [
    {key:'本',g:g.benGua},{key:'互',g:g.huGua},{key:'变',g:g.bianGua},{key:'错',g:g.cuoGua},{key:'综',g:g.zongGua}
  ];
  var h = '<div class="card-hex-mini">';
  for (var i = 0; i < guas.length; i++) {
    var gg = guas[i].g;
    if (!gg) continue;
    var up = triLines(gg.upper), lo = triLines(gg.lower);
    var allLines = [up[2], up[1], up[0], lo[2], lo[1], lo[0]];
    h += '<div class="hex-item"><div class="hex-label">' + guas[i].key + '</div><div class="hex-lines">';
    for (var li = 0; li < 6; li++) {
      h += '<div class="hex-line' + (allLines[li] ? ' hl-yang' : '') + '">';
      if (!allLines[li]) h += '<span></span><span></span>';
      h += '</div>';
    }
    h += '</div><div class="hex-name">' + (gg.name || '') + '</div></div>';
  }
  h += '</div>';
  return h;
}

function renderLiuyaoHex(g) {
  if (!g.benGua) return '';
  // 简化的六爻卡片：本卦+变卦并排
  var ben = g.benGua, bian = g.bianGua;
  function triLines(n) { var m={'1':[1,1,1],'2':[1,1,0],'3':[1,0,1],'4':[1,0,0],'5':[0,1,1],'6':[0,1,0],'7':[0,0,1],'8':[0,0,0]}; return m[String(n)]||[0,0,0]; }
  var l1 = triLines(ben.upper).concat(triLines(ben.lower));
  var l2 = bian && bian.upper ? triLines(bian.upper).concat(triLines(bian.lower)) : null;
  // 反过来
  l1 = [l1[2],l1[1],l1[0],l1[5],l1[4],l1[3]];
  if (l2) l2 = [l2[2],l2[1],l2[0],l2[5],l2[4],l2[3]];

  function bar(y) { return y ? '<span class="b-yang"></span>' : '<span class="b-yin"><i></i><i></i></span>'; }
  var h = '<div class="card-ly-hex">';
  h += '<div class="ly-col"><div class="ly-title">本卦 · ' + (ben.name || '') + '</div><div class="card-ly-rows">';
  for (var i = 0; i < 6; i++) {
    h += '<div class="card-ly-row"><div class="ly-bar">' + bar(l1[i]) + '</div></div>';
  }
  h += '</div></div>';
  if (l2 && bian && bian.name) {
    h += '<div class="ly-col"><div class="ly-title">变卦 · ' + bian.name + '</div><div class="card-ly-rows">';
    for (var i = 0; i < 6; i++) {
      h += '<div class="card-ly-row"><div class="ly-bar">' + bar(l2[i]) + '</div></div>';
    }
    h += '</div></div>';
  }
  h += '</div>';
  return h;
}

// ===== 发送消息 =====
async function sendMessage() {
  if (isSending) return;
  var input = document.getElementById('chatInput');
  var text = input.value.trim();
  if (!text) return;

  input.value = '';
  autoResizeInput(input);

  // 检测是否包含三个数字 → 自动起卦
  var nums = extractThreeNumbers(text);
  if (nums) {
    // 先添加纯文字消息
    var userMsg = { role: 'user', content: text, type: 'text', createdAt: Date.now() };
    allMessages.push(userMsg);
    appendMessageDOM(userMsg, true);
    // 自动起卦（内部会处理后续的 AI 请求）
    doAutoDivination(nums[0], nums[1], nums[2]);
    return;
  }

  // 添加用户消息（正常文字）
  var userMsg = { role: 'user', content: text, type: 'text', createdAt: Date.now() };
  allMessages.push(userMsg);
  appendMessageDOM(userMsg, true);

  // 禁用发送按钮
  isSending = true;
  document.getElementById('sendBtn').disabled = true;
  // 30秒超时保护：防止 onloadend 没触导致 isSending 卡死
  var sendTimeout = setTimeout(function() {
    if (isSending) {
      isSending = false;
      document.getElementById('sendBtn').disabled = false;
      var loading = document.getElementById('aiLoading');
      if (loading) loading.remove();
    }
  }, 30000);
  // 重置流式渲染状态
  streamFirstRender = true;
  if (streamRenderTimer) { clearTimeout(streamRenderTimer); streamRenderTimer = null; }
  streamDivCache = null;

  // 显示加载中
  var area = document.getElementById('msgsArea');
  var loadingDiv = document.createElement('div');
  loadingDiv.className = 'msg msg-ai';
  loadingDiv.innerHTML = '<div class="msg-bubble"><span class="ai-spinner"></span> 思考中…</div>';
  loadingDiv.id = 'aiLoading';
  area.appendChild(loadingDiv);
  scrollToBottom();

  try {
    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/api/chat/send');
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.setRequestHeader('Authorization', 'Bearer ' + AUTH.getToken());

    var fullText = '';

    xhr.onprogress = function() {
      var newText = xhr.responseText.substring(fullText.length);
      if (newText) {
        if (fullText === '') {
          // 移除 loading
          var loading = document.getElementById('aiLoading');
          if (loading) loading.remove();
        }
        fullText = xhr.responseText;
        updateStreamText(fullText);
      }
    };

    xhr.onloadend = function() {
      clearTimeout(sendTimeout);
      isSending = false;
      document.getElementById('sendBtn').disabled = false;
      
      var loading = document.getElementById('aiLoading');
      if (loading) loading.remove();

      if (fullText) {
        // 提取 token 信息
        var tokenInfo = '';
        var tokenIdx = fullText.lastIndexOf('\n消耗 Token：');
        var aiContent = fullText;
        if (tokenIdx > 0) {
          tokenInfo = fullText.substring(tokenIdx).trim();
          aiContent = fullText.substring(0, tokenIdx).trim();
        }

        // 替换流式 div 为最终消息
        var streamDiv = document.querySelector('.msg-ai.streaming');
        if (streamDiv) {
          streamDiv.classList.remove('streaming');
          streamDiv.innerHTML = '<div class="msg-bubble">' + renderMarkdown(aiContent) + '</div>';
          if (tokenInfo) {
            var tokDiv = document.createElement('div');
            tokDiv.className = 'msg-token';
            tokDiv.textContent = tokenInfo;
            streamDiv.parentNode.insertBefore(tokDiv, streamDiv.nextSibling);
          }
        }

        // 保存到历史
        var aiMsg = { role: 'assistant', content: aiContent, type: 'text', createdAt: Date.now() };
        if (tokenInfo) aiMsg.tokenInfo = tokenInfo;
        allMessages.push(aiMsg);
      }
      scrollToBottom();
    };

    xhr.onerror = function() {
      clearTimeout(sendTimeout);
      isSending = false;
      document.getElementById('sendBtn').disabled = false;
      var loading = document.getElementById('aiLoading');
      if (loading) loading.remove();
      showError('连接失败，请重试');
    };

    xhr.send(JSON.stringify({
      message: text,
      cardType: 'text',
    }));

  } catch (e) {
    clearTimeout(sendTimeout);
    isSending = false;
    document.getElementById('sendBtn').disabled = false;
    var loading = document.getElementById('aiLoading');
    if (loading) loading.remove();
    showError('发送失败：' + e.message);
  }
}

// ===== 流式渲染（首次立即渲染，后续节流 120ms）=====
var streamRenderTimer = null;
var streamPendingText = '';
var streamDivCache = null;
var streamFirstRender = true;

function updateStreamText(text) {
  streamPendingText = text;
  
  // 首次渲染：立即执行，不节流
  if (streamFirstRender) {
    streamFirstRender = false;
    doStreamRender();
    return;
  }
  
  // 后续更新：节流 120ms
  if (streamRenderTimer) return;
  streamRenderTimer = setTimeout(doStreamRender, 120);
}

function doStreamRender() {
  streamRenderTimer = null;
  var full = streamPendingText;
  if (!full) return;

  var streamDiv = streamDivCache;
  if (!streamDiv || !document.body.contains(streamDiv)) {
    streamDiv = document.querySelector('.msg-ai.streaming');
    if (!streamDiv) {
      var area = document.getElementById('msgsArea');
      streamDiv = document.createElement('div');
      streamDiv.className = 'msg msg-ai streaming';
      area.appendChild(streamDiv);
    }
    streamDivCache = streamDiv;
  }

  // 去掉 token 行用于渲染 markdown
  var displayText = full;
  var tokenIdx = full.lastIndexOf('\n消耗 Token：');
  if (tokenIdx > 0) displayText = full.substring(0, tokenIdx);

  streamDiv.innerHTML = '<div class="msg-bubble">' + renderMarkdown(displayText) + '</div>';
  // 流式输出中：只在用户位于底部时自动跟随，不强制打断用户阅读
  if (isNearBottom()) scrollToBottom();
}

function showError(msg) {
  var area = document.getElementById('msgsArea');
  var div = document.createElement('div');
  div.className = 'msg msg-ai';
  div.innerHTML = '<div class="msg-bubble msg-error">❌ ' + escHtml(msg) + '</div>';
  area.appendChild(div);
  scrollToBottom();
}

// ===== 发送排盘卡片 =====
async function sendCard(type, record) {
  if (isSending) return;
  
  closeSharePicker();

  // 获取完整记录
  var fullData;
  try {
    var apiPath = type === 'mhys' ? '/api/mhys-records/' + record.id : '/api/liuyao-records/' + record.id;
    var resp = await fetch(apiPath, {
      headers: { 'Authorization': 'Bearer ' + AUTH.getToken() }
    });
    if (!resp.ok) { showError('获取排盘详情失败'); return; }
    fullData = await resp.json();
  } catch (e) { showError('获取排盘详情失败'); return; }

  var resultData;
  try {
    resultData = typeof fullData.result_data === 'string' ? JSON.parse(fullData.result_data) : fullData.result_data;
  } catch(e) { showError('排盘数据解析失败'); return; }

  // 构建卡片数据
  var cardData = {
    topic: fullData.topic || '',
    divinationTime: resultData.divinationTime || '',
    method: resultData.method || fullData.method || '',
    gender: resultData.gender || '',
  };

  if (type === 'mhys') {
    cardData.hexagrams = resultData.gua || resultData.hexagrams;
    if (!cardData.hexagrams && resultData.result && resultData.result.gua) {
      cardData.hexagrams = resultData.result.gua;
    }
    // 修复 hexagrams 结构
    var hx = cardData.hexagrams;
    if (hx && hx.benGua) {
      // 确保有 upperTri/lowerTri
      var guas = ['benGua','huGua','bianGua','cuoGua','zongGua'];
      for (var gi = 0; gi < guas.length; gi++) {
        var gk = guas[gi], g = hx[gk];
        if (g && !g.upperTri && g.upper) g.upperTri = TRIGRAMS[String(g.upper)] || {name:'',symbol:''};
        if (g && !g.lowerTri && g.lower) g.lowerTri = TRIGRAMS[String(g.lower)] || {name:'',symbol:''};
        if (g && !g.name && g.upperTri && g.lowerTri) g.name = (g.upperTri.name||'')+(g.lowerTri.name||'');
      }
    }
  }

  if (type === 'liuyao') {
    cardData.hexagrams = resultData.gua || resultData.hexagrams;
    if (!cardData.hexagrams && resultData.result && resultData.result.gua) {
      cardData.hexagrams = resultData.result.gua;
    }
    var hx = cardData.hexagrams;
    if (hx && hx.benGua) {
      var guas = ['benGua','bianGua'];
      for (var gi = 0; gi < guas.length; gi++) {
        var gk = guas[gi], g = hx[gk];
        if (g && !g.upperTri && g.upper) g.upperTri = TRIGRAMS[String(g.upper)] || {name:'',symbol:''};
        if (g && !g.lowerTri && g.lower) g.lowerTri = TRIGRAMS[String(g.lower)] || {name:'',symbol:''};
      }
    }
  }

  // 添加用户卡片消息
  var cardMsg = { role: 'user', type: type, cardData: cardData, content: '', createdAt: Date.now() };
  allMessages.push(cardMsg);

  var area = document.getElementById('msgsArea');
  var empty = document.getElementById('emptyState');
  empty.style.display = 'none';

  var cardDiv = document.createElement('div');
  cardDiv.className = 'msg-card';
  cardDiv.innerHTML = renderCard(type, cardData, '');
  area.appendChild(cardDiv);
  scrollToBottom();

  // 自动发 AI 解析请求
  isSending = true;
  document.getElementById('sendBtn').disabled = true;
  // 30秒超时保护
  var cardTimeout = setTimeout(function() {
    if (isSending) {
      isSending = false;
      document.getElementById('sendBtn').disabled = false;
      var loading = document.getElementById('aiLoading');
      if (loading) loading.remove();
    }
  }, 30000);
  // 重置流式渲染状态
  streamFirstRender = true;
  if (streamRenderTimer) { clearTimeout(streamRenderTimer); streamRenderTimer = null; }
  streamDivCache = null;

  var loadingDiv = document.createElement('div');
  loadingDiv.className = 'msg msg-ai';
  loadingDiv.innerHTML = '<div class="msg-bubble"><span class="ai-spinner"></span> 解析中…</div>';
  loadingDiv.id = 'aiLoading';
  area.appendChild(loadingDiv);
  scrollToBottom();

  try {
    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/api/chat/send');
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.setRequestHeader('Authorization', 'Bearer ' + AUTH.getToken());

    var fullText = '';

    xhr.onprogress = function() {
      var newText = xhr.responseText.substring(fullText.length);
      if (newText) {
        if (fullText === '') {
          var loading = document.getElementById('aiLoading');
          if (loading) loading.remove();
        }
        fullText = xhr.responseText;
        updateStreamText(fullText);
      }
    };

    xhr.onloadend = function() {
      isSending = false;
      document.getElementById('sendBtn').disabled = false;
      var loading = document.getElementById('aiLoading');
      if (loading) loading.remove();

      if (fullText) {
        var tokenInfo = '';
        var tokenIdx = fullText.lastIndexOf('\n消耗 Token：');
        var aiContent = fullText;
        if (tokenIdx > 0) {
          tokenInfo = fullText.substring(tokenIdx).trim();
          aiContent = fullText.substring(0, tokenIdx).trim();
        }
        var streamDiv = document.querySelector('.msg-ai.streaming');
        if (streamDiv) {
          streamDiv.classList.remove('streaming');
          streamDiv.innerHTML = '<div class="msg-bubble">' + renderMarkdown(aiContent) + '</div>';
          if (tokenInfo) {
            var tokDiv = document.createElement('div');
            tokDiv.className = 'msg-token';
            tokDiv.textContent = tokenInfo;
            streamDiv.parentNode.insertBefore(tokDiv, streamDiv.nextSibling);
          }
        }
        var aiMsg = { role: 'assistant', content: aiContent, type: 'text', createdAt: Date.now() };
        if (tokenInfo) aiMsg.tokenInfo = tokenInfo;
        allMessages.push(aiMsg);
      }
      scrollToBottom();
    };

    xhr.send(JSON.stringify({
      message: '',
      cardType: type,
      cardData: cardData,
    }));

  } catch (e) {
    clearTimeout(cardTimeout);
    isSending = false;
    document.getElementById('sendBtn').disabled = false;
    var loading = document.getElementById('aiLoading');
    if (loading) loading.remove();
    showError('发送失败：' + e.message);
  }
}

// ===== 分享排盘选择器 =====
var pickerType = 'mhys';

function openSharePicker() {
  document.getElementById('pickerOverlay').classList.add('open');
  document.getElementById('pickerPanel').classList.add('open');
  // 保持上次选择的 tab，同时重置 tab 高亮
  document.querySelectorAll('.picker-tab').forEach(function(t){
    t.classList.toggle('active', t.dataset.type === pickerType);
  });
  loadPickerData(pickerType);
}

// ===== 快速起卦 =====

function calcQuickGuaData(upper, lower, move) {
  var upTri = TRIGRAMS[String(upper)] || {name:'?',symbol:'?'};
  var loTri = TRIGRAMS[String(lower)] || {name:'?',symbol:'?'};
  var hexName = getHexagramName(upper, lower);
  
  // 互卦：本卦中间四爻
  var allLines = [
    triToLinesArr(upper)[2], triToLinesArr(upper)[1], triToLinesArr(upper)[0],
    triToLinesArr(lower)[2], triToLinesArr(lower)[1], triToLinesArr(lower)[0]
  ];
  var huUpper = linesToTriNum([allLines[0], allLines[1], allLines[2]]);  // 4-6爻
  var huLower = linesToTriNum([allLines[2], allLines[3], allLines[4]]);  // 3-5爻… 不对，互卦是2-4,3-5
  // 互卦是234爻为下卦，345爻为上卦
  var huUpper2 = linesToTriNum([allLines[1], allLines[2], allLines[3]]);
  var huLower2 = linesToTriNum([allLines[2], allLines[3], allLines[4]]);
  
  // 错卦：全部阴阳互换
  var cuoLines = allLines.map(function(l){ return l === 1 ? 0 : 1; });
  var cuoUpper = linesToTriNum([cuoLines[0], cuoLines[1], cuoLines[2]]);
  var cuoLower = linesToTriNum([cuoLines[3], cuoLines[4], cuoLines[5]]);

  // 综卦：上下颠倒
  var zongLines = allLines.slice().reverse();
  var zongUpper = linesToTriNum([zongLines[0], zongLines[1], zongLines[2]]);
  var zongLower = linesToTriNum([zongLines[3], zongLines[4], zongLines[5]]);

  return {
    benGua: {
      upper: upper, lower: lower,
      name: hexName,
      upperTri: upTri, lowerTri: loTri,
      movingYao: [move]
    },
    huGua: {
      upper: huUpper2, lower: huLower2,
      name: getHexagramName(huUpper2, huLower2),
      upperTri: TRIGRAMS[String(huUpper2)] || {name:'?',symbol:'?'},
      lowerTri: TRIGRAMS[String(huLower2)] || {name:'?',symbol:'?'}
    },
    bianGua: {},
    cuoGua: {
      upper: cuoUpper, lower: cuoLower,
      name: getHexagramName(cuoUpper, cuoLower),
      upperTri: TRIGRAMS[String(cuoUpper)] || {name:'?',symbol:'?'},
      lowerTri: TRIGRAMS[String(cuoLower)] || {name:'?',symbol:'?'}
    },
    zongGua: {
      upper: zongUpper, lower: zongLower,
      name: getHexagramName(zongUpper, zongLower),
      upperTri: TRIGRAMS[String(zongUpper)] || {name:'?',symbol:'?'},
      lowerTri: TRIGRAMS[String(zongLower)] || {name:'?',symbol:'?'}
    },
    ti: (function(){ var ty=calcTiYong(upper,lower,move); return { tri: ty.ti }; })(),
    yong: (function(){ var ty=calcTiYong(upper,lower,move); return { tri: ty.yong }; })(),
    verdict: (function(){ var ty=calcTiYong(upper,lower,move); return ty.verdict; })()
  };
}

function calcTiYong(upper, lower, move) {
  // 体卦：不动之卦（动爻所在的三画卦为用）
  // move 1-3：下卦动，体为上卦；move 4-6：上卦动，体为下卦
  var isUpperMove = move >= 4;
  var tiTri = isUpperMove ? lower : upper;
  var yongTri = isUpperMove ? upper : lower;
  var tiT = TRIGRAMS[String(tiTri)] || {name:'?',symbol:'?',element:'?'};
  var yoN = TRIGRAMS[String(yongTri)] || {name:'?',symbol:'?',element:'?'};
  
  var wx = {1:'金',2:'金',3:'火',4:'木',5:'木',6:'水',7:'土',8:'土'};
  tiT.element = wx[tiTri] || '?';
  yoN.element = wx[yongTri] || '?';
  
  var sheng = {木:'火',火:'土',土:'金',金:'水',水:'木'};
  var ke = {木:'土',土:'水',水:'火',火:'金',金:'木'};

  var txt, dsc;
  if (sheng[tiT.element] === yoN.element) { txt='体生用'; dsc='我去主动促成事情发展，但也意味着需要付出精力。'; }
  else if (sheng[yoN.element] === tiT.element) { txt='用生体'; dsc='事情发展有利，不必太费心力就有收获。'; }
  else if (ke[tiT.element] === yoN.element) { txt='体克用'; dsc='问题在可控范围内，花些功夫就能解决。'; }
  else if (ke[yoN.element] === tiT.element) { txt='用克体'; dsc='外部阻力较大，需要谨慎应对。'; }
  else { txt='体用比和'; dsc='内外一致，诸事顺利。'; }
  return { ti: tiT, yong: yoN, verdict: { text: txt, cls: '', desc: dsc } };
}

function triToLinesArr(n) {
  var m = {'1':[1,1,1],'2':[1,1,0],'3':[1,0,1],'4':[1,0,0],'5':[0,1,1],'6':[0,1,0],'7':[0,0,1],'8':[0,0,0]};
  return m[String(n)] || [0,0,0];
}

function linesToTriNum(lines) {
  var k = lines.join('');
  var m = {'111':1,'110':2,'101':3,'100':4,'011':5,'010':6,'001':7,'000':8};
  return m[k] || 8;
}

function getHexagramName(upper, lower) {
  var names = [
    ['乾为天','泽天夬','火天大有','雷天大壮','风天小畜','水天需','山天大畜','地天泰'],
    ['天泽履','兑为泽','火泽睽','雷泽归妹','风泽中孚','水泽节','山泽损','地泽临'],
    ['天火同人','泽火革','离为火','雷火丰','风火家人','水火既济','山火贲','地火明夷'],
    ['天雷无妄','泽雷随','火雷噬嗑','震为雷','风雷益','水雷屯','山雷颐','地雷复'],
    ['天风姤','泽风大过','火风鼎','雷风恒','巽为风','水风井','山风蛊','地风升'],
    ['天水讼','泽水困','火水未济','雷水解','风水涣','坎为水','山水蒙','地水师'],
    ['天山遁','泽山咸','火山旅','雷山小过','风山渐','水山蹇','艮为山','地山谦'],
    ['天地否','泽地萃','火地晋','雷地豫','风地观','水地比','山地剥','坤为地']
  ];
  return (names[lower-1] && names[lower-1][upper-1]) || (TRIGRAMS[String(upper)] && TRIGRAMS[String(lower)] ? TRIGRAMS[String(upper)].name + TRIGRAMS[String(lower)].name : '未知');
}

function toast(msg) {
  var el = document.createElement('div');
  el.textContent = msg;
  Object.assign(el.style, {
    position:'fixed', bottom:'6rem', left:'50%', transform:'translateX(-50%)',
    background:'rgba(0,0,0,0.75)', color:'#fff', padding:'0.5rem 1rem',
    borderRadius:'8px', fontSize:'0.78rem', zIndex:'300',
    maxWidth:'360px', textAlign:'center', lineHeight:'1.5',
    animation:'fadeIn 0.2s'
  });
  document.body.appendChild(el);
  setTimeout(function(){ el.remove(); }, 2500);
}

function closeSharePicker() {
  document.getElementById('pickerOverlay').classList.remove('open');
  document.getElementById('pickerPanel').classList.remove('open');
}

function switchPickerTab(type) {
  pickerType = type;
  document.querySelectorAll('.picker-tab').forEach(function(t){
    t.classList.toggle('active', t.dataset.type === type);
  });
  loadPickerData(type);
}

function loadPickerData(type) {
  var body = document.getElementById('pickerBody');
  body.innerHTML = '<div class="picker-loading"><div class="pk-spinner"></div><div>加载中…</div></div>';

  var apiPath;
  if (type === 'mhys') apiPath = '/api/mhys-records';
  else if (type === 'liuyao') apiPath = '/api/liuyao-records';
  else apiPath = '/api/charts';

  fetch(apiPath, {
    headers: { 'Authorization': 'Bearer ' + AUTH.getToken() }
  })
  .then(function(r){ return r.json(); })
  .then(function(data){
    var list = Array.isArray(data) ? data : [];
    if (list.length === 0) {
      body.innerHTML = '<div class="picker-empty">暂无记录</div>';
      return;
    }
    var h = '';
    for (var i = 0; i < list.length; i++) {
      var item = list[i];
      var icon = type === 'mhys' ? '🌸' : (type === 'liuyao' ? '🪙' : '🔮');
      var topic = item.topic || item.name || '未命名';
      var meta = '';
      if (item.divinationTime) meta = item.divinationTime;
      else if (item.created_at) meta = new Date(item.created_at).toLocaleString('zh-CN');
      else if (item.birthYear) meta = item.birthYear + '年' + (item.birthMonth||'') + '月';
      h += '<div class="picker-item" onclick="sendCard(\'' + type + '\',' + JSON.stringify(item).replace(/"/g,'&quot;') + ')">';
      h += '<span class="pi-icon">' + icon + '</span>';
      h += '<div class="pi-body"><div class="pi-topic">' + escHtml(topic) + '</div>';
      h += '<div class="pi-meta">' + escHtml(meta) + '</div></div></div>';
    }
    body.innerHTML = h;
  })
  .catch(function(){
    body.innerHTML = '<div class="picker-empty">加载失败</div>';
  });
}

// ===== 清空历史 =====
function clearHistory() {
  if (allMessages.length === 0) return;
  if (!confirm('确定清空所有对话历史？')) return;
  // 立即清空前端界面，不等后端响应
  allMessages = [];
  document.getElementById('msgsArea').innerHTML = '';
  document.getElementById('emptyState').style.display = 'block';
  scrollToBottom();
  // 后端异步清空
  fetch('/api/chat/history', {
    method: 'DELETE',
    headers: { 'Authorization': 'Bearer ' + AUTH.getToken() }
  }).catch(function(){});
  // 重置流式渲染状态
  streamFirstRender = true;
  if (streamRenderTimer) { clearTimeout(streamRenderTimer); streamRenderTimer = null; }
  streamDivCache = null;
  isSending = false;
  document.getElementById('sendBtn').disabled = false;
}

// ===== 工具函数 =====
function escHtml(s) {
  if (!s) return '';
  var d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}

function autoResizeInput(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 120) + 'px';
}

// 判断用户是否在消息区域底部附近（50px 容差）
function isNearBottom() {
  var area = document.getElementById('msgsArea');
  if (!area) return true;
  return area.scrollHeight - area.scrollTop - area.clientHeight < 80;
}

function scrollToBottom(force) {
  if (window._scrollRaf) cancelAnimationFrame(window._scrollRaf);
  window._scrollRaf = requestAnimationFrame(function(){
    window._scrollRaf = null;
    var area = document.getElementById('msgsArea');
    if (!area) return;
    // 如果用户手动划上去了，不强制滚动（除非 force=true）
    if (!force && !isNearBottom()) return;
    area.scrollTop = area.scrollHeight;
  });
}

function onInputKeydown(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
}

function renderMarkdown(text) {
  if (!text) return '';
  text = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  text = text.replace(/```(\w*)\n?([\s\S]*?)```/g, function(m,a,code){ return '<pre>'+code.trim()+'</pre>'; });
  text = text.replace(/`([^`]+)`/g, '<code>$1</code>');
  text = text.replace(/^---+\s*$/gm, '<hr>');
  text = text.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  text = text.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  text = text.replace(/^# (.+)$/gm, '<h2>$1</h2>');
  text = text.replace(/^【([^】]+)】/gm, '<div style="font-family:var(--serif);font-size:0.88rem;font-weight:700;color:var(--accent);margin:0.5rem 0 0.2rem;letter-spacing:0.04em">【$1】</div>');
  text = text.replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>');
  text = text.replace(/^[\s]*[-*] (.+)$/gm, function(m,c){ return '<span style="display:block;padding-left:1rem;position:relative;line-height:1.8"><span style="position:absolute;left:0.1rem">•</span>'+c+'</span>'; });
  text = text.replace(/^[\s]*\d+\. (.+)$/gm, function(m,c){ return '<span style="display:block;padding-left:1rem;line-height:1.8">'+c+'</span>'; });
  text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  text = text.replace(/\*([^*]+)\*/g, '<em>$1</em>');
  var lines = text.split(/\n/);
  var out = [], inPara = false;
  for (var i = 0; i < lines.length; i++) {
    var l = lines[i], isBlock = /^<(h[23]|pre|blockquote|hr|span|div)/.test(l), isEmpty = l.trim() === '';
    if (isBlock) { if (inPara) { out.push('</p>'); inPara = false; } out.push(l); }
    else if (isEmpty) { if (inPara) { out.push('</p>'); inPara = false; } }
    else { if (!inPara) { out.push('<p>'); inPara = true; } else { out.push('<br>'); } out.push(l); }
  }
  if (inPara) out.push('</p>');
  return out.join('');
}

// ===== 自动起卦（检测用户消息中的三个数字）=====

function getShichenNum() {
  var h = new Date().getHours();
  if (h >= 23 || h < 1) return 1;
  if (h < 3) return 2;
  if (h < 5) return 3;
  if (h < 7) return 4;
  if (h < 9) return 5;
  if (h < 11) return 6;
  if (h < 13) return 7;
  if (h < 15) return 8;
  if (h < 17) return 9;
  if (h < 19) return 10;
  if (h < 21) return 11;
  return 12;
}

// 从消息中检测三个数字（1-9），返回 [n1,n2,n3] 或 null
function extractThreeNumbers(text) {
  var digits = text.replace(/[^1-9]/g, '').split('').map(Number);
  if (digits.length === 3) return digits;
  // 也支持类似 "12 34 56" 的两位数
  var nums = text.match(/\d+/g);
  if (nums && nums.length === 3) {
    var parsed = nums.map(Number).filter(function(n){ return n >= 1 && n <= 99; });
    if (parsed.length === 3) return parsed;
  }
  return null;
}

// 执行自动起卦并发送卡片
function doAutoDivination(n1, n2, n3) {
  var upper = n1 % 8; if (upper === 0) upper = 8;
  var lower = n2 % 8; if (lower === 0) lower = 8;
  var moveRaw = n3;
  moveRaw += getShichenNum();
  var move = moveRaw % 6; if (move === 0) move = 6;

  var hexData = calcQuickGuaData(upper, lower, move);

  // 计算变卦
  var upLines = triToLinesArr(upper);
  var loLines = triToLinesArr(lower);
  var all = [upLines[2], upLines[1], upLines[0], loLines[2], loLines[1], loLines[0]];
  var moveIdx = 6 - move;
  all[moveIdx] = all[moveIdx] === 1 ? 0 : 1;
  var newUpper = linesToTriNum([all[0], all[1], all[2]]);
  var newLower = linesToTriNum([all[3], all[4], all[5]]);

  hexData.bianGua = {
    upper: newUpper, lower: newLower,
    name: getHexagramName(newUpper, newLower),
    upperTri: TRIGRAMS[String(newUpper)] || {name:'?',symbol:'?'},
    lowerTri: TRIGRAMS[String(newLower)] || {name:'?',symbol:'?'}
  };

  var cardData = {
    topic: '起卦：' + n1 + ' ' + n2 + ' ' + n3,
    divinationTime: new Date().toLocaleString('zh-CN'),
    method: '数字起卦2',
    hexagrams: hexData
  };

  // 添加到消息列表并显示
  var cardMsg = { role: 'user', type: 'mhys', cardData: cardData, content: '', createdAt: Date.now() };
  allMessages.push(cardMsg);

  document.getElementById('emptyState').style.display = 'none';
  var area = document.getElementById('msgsArea');
  var cardDiv = document.createElement('div');
  cardDiv.className = 'msg-card';
  cardDiv.innerHTML = renderCard('mhys', cardData, '');
  area.appendChild(cardDiv);
  scrollToBottom();

  // 发送给 AI 解析
  isSending = true;
  document.getElementById('sendBtn').disabled = true;
  // 30秒超时保护
  var divTimeout = setTimeout(function() {
    if (isSending) {
      isSending = false;
      document.getElementById('sendBtn').disabled = false;
      var loading = document.getElementById('aiLoading');
      if (loading) loading.remove();
    }
  }, 30000);
  streamFirstRender = true;
  if (streamRenderTimer) { clearTimeout(streamRenderTimer); streamRenderTimer = null; }
  streamDivCache = null;

  var loadingDiv = document.createElement('div');
  loadingDiv.className = 'msg msg-ai';
  loadingDiv.innerHTML = '<div class="msg-bubble"><span class="ai-spinner"></span> 解卦中…</div>';
  loadingDiv.id = 'aiLoading';
  area.appendChild(loadingDiv);
  scrollToBottom();

  var xhr = new XMLHttpRequest();
  xhr.open('POST', '/api/chat/send');
  xhr.setRequestHeader('Content-Type', 'application/json');
  xhr.setRequestHeader('Authorization', 'Bearer ' + AUTH.getToken());

  var fullText = '';

  xhr.onprogress = function() {
    var newText = xhr.responseText.substring(fullText.length);
    if (newText) {
      if (fullText === '') {
        var loading = document.getElementById('aiLoading');
        if (loading) loading.remove();
      }
      fullText = xhr.responseText;
      updateStreamText(fullText);
    }
  };

  xhr.onloadend = function() {
    clearTimeout(divTimeout);
    isSending = false;
    document.getElementById('sendBtn').disabled = false;
    var loading = document.getElementById('aiLoading');
    if (loading) loading.remove();

    if (fullText) {
      var tokenInfo = '';
      var tokenIdx = fullText.lastIndexOf('\n消耗 Token：');
      var aiContent = fullText;
      if (tokenIdx > 0) {
        tokenInfo = fullText.substring(tokenIdx).trim();
        aiContent = fullText.substring(0, tokenIdx).trim();
      }
      var streamDiv = document.querySelector('.msg-ai.streaming');
      if (streamDiv) {
        streamDiv.classList.remove('streaming');
        streamDiv.innerHTML = '<div class="msg-bubble">' + renderMarkdown(aiContent) + '</div>';
        if (tokenInfo) {
          var tokDiv = document.createElement('div');
          tokDiv.className = 'msg-token';
          tokDiv.textContent = tokenInfo;
          streamDiv.parentNode.insertBefore(tokDiv, streamDiv.nextSibling);
        }
      }
      var aiMsg = { role: 'assistant', content: aiContent, type: 'text', createdAt: Date.now() };
      if (tokenInfo) aiMsg.tokenInfo = tokenInfo;
      allMessages.push(aiMsg);
    }
    scrollToBottom();
  };

  xhr.onerror = function() {
    clearTimeout(divTimeout);
    isSending = false;
    document.getElementById('sendBtn').disabled = false;
    var loading = document.getElementById('aiLoading');
    if (loading) loading.remove();
    showError('连接失败，请重试');
  };

  xhr.send(JSON.stringify({ message: '', cardType: 'mhys', cardData: cardData }));
}

</script>
</body>
</html>
