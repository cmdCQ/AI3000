# 易三千 环境变量模板 —— 复制为 docker/.env 后填真值。
# ⚠ docker/.env 已被 .gitignore 排除，任何真凭据都不要提交。
# 本文件（.env.example）只是模板，里面不放任何真实密钥。

# ── 必需 ─────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
MYSQL_ROOT_PASSWORD=给MySQLroot设一个密码
MYSQL_PASSWORD=给ai3000用户设一个密码
ADMIN_PASSWORD=管理后台密码
ALIBABA_ACCESS_KEY_ID=阿里云短信AccessKeyId
ALIBABA_ACCESS_KEY_SECRET=阿里云短信AccessKeySecret

# ── 可选（不填走默认值）───────────────────────────────
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# WECHAT_APP_SECRET=微信登录用（不用微信登录可留空）
