# Secrets
.env
*.secret
*.key
*.pem
.jwt_secret

# Data files (contain user PII)
data/users.json
data/admin.json
data/announcement_cache.json
data/server_config.json

# Backups
backups/
# 手工备份残留：*.bak-<时间戳> 曾被真的 commit 进库，这里结构性挡掉
*.bak
*.bak-*
*.bak.*
*.old
*.orig
*.save

# Docker volumes
docker/volumes/

# Node
node_modules/

# 独立博客应用，非本项目内容（含第三方 jar/主题，39M）
halo/

# ── faker/ 是构建产物，不入库 ──────────────────────────────
# 源码: /root/.openclaw/workspace/faker-site  (Vite + React 18)
# 重建: cd /root/.openclaw/workspace/faker-site && npm i && npm run build
#       rsync -a --delete dist/ /var/www/sqw.somtfly.com/build/nginx/faker/
# 注意: node_modules 不在本仓库，也不在 faker-site/ 里，首次重建需要联网 npm i
build/nginx/faker/

# Python 字节码缓存（生成物，不该入库）
__pycache__/
*.pyc

# ── build/ 是部署目录，由 src/ 生成 ────────────────────────
# 改前端请改 src/web/，然后跑 deploy/sync.sh
# build/nginx 是 nginx 容器的挂载点（/usr/share/nginx/html），内容由 rsync 生成
/build/nginx/
