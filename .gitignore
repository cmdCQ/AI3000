# Secrets
.env
*.secret
*.key
*.pem
.jwt_secret

# Data files (contain user PII)
data/users.json
data/admin.json
data/announcement_cache.json
data/server_config.json

# Backups
backups/
# 手工备份残留：*.bak-<时间戳> 曾被真的 commit 进库，这里结构性挡掉
*.bak
*.bak-*
*.bak.*
*.old
*.orig
*.save

# Docker volumes
docker/volumes/

# Node
node_modules/

# Python 字节码缓存（生成物，不该入库）
__pycache__/
*.pyc

# ── duipan/ 对拍 harness 的产物 ────────────────────────────
# 基准是 golden_*.json（**进库**，它们就是「shushu 说了什么」的记录）。
# 下面两类是跑回归时吐出来的，别进库 —— 合起来 ~347MB：
#   js_*.json         runner 跑一遍 JS 实现的结果
#   probe_meihua.json probe_meihua.js:90 吐的，给 coverage_meihua.py:66 当输入
#   *_strict.json     diff 脚本当场切出来的「严格段」子集（diff_bazi_chart.py:189、
#                     diff_bazi_fortune.py:245 写的，**不是基准**）
/duipan/js_*.json
/duipan/probe_meihua.json
/duipan/*_strict.json

# ── build/ 全是部署产物，由 src/ 生成，不入库 ──────────────
# 人只改 src/，然后跑 deploy/sync.sh：
#   src/web/    → build/nginx/    nginx 容器挂载 /usr/share/nginx/html
#   src/server/ → build/backend/  backend 容器挂载单文件，rsync --inplace 保住 inode
#   src/rag/、src/upload/ 不被挂载，是构建 docker-rag / docker-upload 镜像的源码
# rm -rf build/ && ./deploy/sync.sh 可完全重建（已实测通过）
/build/
